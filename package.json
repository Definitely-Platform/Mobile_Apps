{
  "name": "definitely-one-ecosystem",
  "version": "1.0.0",
  "private": true,
  "description": "Definitely One cross-platform mobile app (client) and backend gateway (server)",
  "scripts": {
    "start:client": "npm start --prefix client",
    "ios": "npm run ios --prefix client",
    "android": "npm run android --prefix client",
    "web": "npm run web --prefix client",
    "start:server": "node server/src/index.ts",
    "dev:server": "node --watch server/src/index.ts",
    "typecheck:client": "npm run typecheck --prefix client",
    "typecheck:server": "./client/node_modules/.bin/tsc --project server/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server"
  }
}
