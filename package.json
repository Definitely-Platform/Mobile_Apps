{
  "name": "definitely-mobile-ecosystem",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Definitely Platforms Unified Mobile Ecosystem Monorepo",
  "workspaces": [
    "apps/*",
    "apps/*/client",
    "apps/*/server",
    "packages/*"
  ],
  "scripts": {
    "start:one": "npm start --prefix apps/definitely-one/client",
    "android:one": "npm run android --prefix apps/definitely-one/client",
    "ios:one": "npm run ios --prefix apps/definitely-one/client",
    "typecheck": "turbo run typecheck",
    "typecheck:one": "npm run typecheck --prefix apps/definitely-one/client",
    "build:one": "turbo run build --filter=@definitely/mobile-one",
    "create-app": "node scripts/create-app.js",
    "clean": "rm -rf node_modules apps/*/client/node_modules apps/*/server/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "~6.0.3"
  }
}
