{
  "expo": {
    "name": "Definitely One",
    "slug": "definitely-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "definitelyone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.definitelyone.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to quickly and securely unlock your Definitely One ecosystem session.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.definitelyone.app",
            "CFBundleURLSchemes": [
              "definitelyone"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.definitelyone.app",
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "definitelyone",
              "host": "auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to securely unlock Definitely One."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cf35175b-c5ea-4e7d-a9b9-a0f8715c16f2"
      },
      "firebase": {
        "appId": "1:919056358557:android:7534014df2fdb48179c874",
        "groups": "qa-testers"
      }
    },
    "owner": "sabrealam"
  }
}
